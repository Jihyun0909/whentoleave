# docker-compose.prod.yml 용 - 실제 값을 채운 .env 파일을 서버(VM)에 만들어 사용한다.
# 이 파일 자체는 예시일 뿐이라 커밋해도 되지만, 채운 .env는 .gitignore로 절대 커밋되지 않는다.

DB_PASSWORD=change-me
# JWT 서명 키(HS256). 32바이트 이상. 운영에서는 반드시 임의의 긴 값으로 채운다.
# 예: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Refresh Token 저장소. prod compose에는 redis 서비스가 있으므로 그대로 redis를 쓴다.
REFRESH_TOKEN_STORE=redis
# 대중교통 경로탐색(환승 조합)용. Google Cloud Console에서 Routes API 활성화 후 발급.
GOOGLE_ROUTES_API_KEY=your-google-routes-api-key
# 주소 검색(VWorld 지오코더/검색)용. 없으면 역 이름 검색만 되고 주소 입력은 실패한다.
VWORLD_API_KEY=your-vworld-api-key
# 실시간 지하철 도착정보(보조 기능)용. 없으면 이 기능만 조용히 꺼지고 나머지는 그대로 동작한다.
SEOUL_SUBWAY_API_KEY=your-seoul-subway-api-key

# 아래 3개는 수도권 실시간 버스 도착정보용(보조 기능). 값이 비어있으면 이 기능만 조용히
# 꺼지고 나머지는 그대로 동작한다. TAGO 우선, 실패하면 경기 -> 인천 순으로 시도한다.
# TAGO(국가대중교통정보센터, data.go.kr) - 사실상 전국(서울 포함) 커버리지, 기본값으로 먼저 시도
TAGO_API_KEY=your-tago-api-key
# 경기도 버스정보시스템(GBIS)
GYEONGGI_BUS_API_KEY=your-gyeonggi-bus-api-key
# 인천 버스정보시스템(BIMS) - 아직 좌표기반 정류소 조회 API가 없어 사실상 항상 빈 값
INCHEON_BUS_API_KEY=your-incheon-bus-api-key

DOMAIN=your-subdomain.duckdns.org
