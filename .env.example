# docker-compose.prod.yml 용 - 실제 값을 채운 .env 파일을 서버(VM)에 만들어 사용한다.
# 이 파일 자체는 예시일 뿐이라 커밋해도 되지만, 채운 .env는 .gitignore로 절대 커밋되지 않는다.

DB_PASSWORD=change-me
ODSAY_API_KEY=your-odsay-api-key
# 주소 검색(VWorld 지오코더/검색)용. 없으면 역 이름 검색만 되고 주소 입력은 실패한다.
VWORLD_API_KEY=your-vworld-api-key
# 실시간 지하철 도착정보(보조 기능)용. 없으면 이 기능만 조용히 꺼지고 나머지는 그대로 동작한다.
SEOUL_SUBWAY_API_KEY=your-seoul-subway-api-key
DOMAIN=your-subdomain.duckdns.org
